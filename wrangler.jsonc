{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "kage",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kage-database",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kage-media"
    }
  ]
}
